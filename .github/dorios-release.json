{
  "$schema": "https://raw.githubusercontent.com/DoriosStudios/Dorios-Workflows/v1.0.2/releases/schemas/project.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "Dorios' Trinkets",
    "slug": "trinkets"
  },
  "release": {
    "changelogPath": "CHANGELOG.md",
    "defaultChannel": "stable",
    "bedrockManifestPaths": [
      "BP/manifest.json",
      "RP/manifest.json"
    ]
  },
  "build": {
    "enabled": true,
    "type": "regolith",
    "developmentProfile": "buildDev",
    "releaseProfile": "buildMinify",
    "outputDirectory": "build",
    "packDirectories": [
      "Dorios' Trinkets BP",
      "Dorios' Trinkets RP"
    ]
  },
  "distribution": {
    "github": true,
    "curseforge": {
      "enabled": true,
      "projectId": 1173489,
      "gameVersion": "26.30"
    }
  },
  "links": {
    "website": "https://doriosstudios.com/projects/trinkets/",
    "curseforge": "https://www.curseforge.com/minecraft-bedrock/addons/dorios-trinkets",
    "mcpedl": "https://mcpedl.com/dorios-trinkets/"
  },
  "announcement": {
    "enabled": true,
    "color": "F09030",
    "imageUrl": "https://doriosstudios.com/img/addons/trinkets/MCPEDL.png",
    "automaticDelayMinutes": 60
  }
}
